<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>EF Core and PostgreSQL persistence for Waybill: outbox capture in the same transaction, migrations, and the dispatcher claim.</Description>
    <RootNamespace>Waybill.EntityFrameworkCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Waybill\Waybill.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- Design-time only: lets `dotnet ef migrations add` generate the package's own migrations. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Waybill.Testing" />
    <InternalsVisibleTo Include="Waybill.Tests.Unit" />
    <InternalsVisibleTo Include="Waybill.Tests.Integration" />
    <InternalsVisibleTo Include="Waybill.Tests.Chaos" />
  </ItemGroup>

</Project>
